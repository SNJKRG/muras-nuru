{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Muras Nuru full landing design handoff",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "version",
    "authority",
    "files",
    "navigation",
    "footer",
    "integration",
    "concept",
    "journeys",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "const": "MURAS NURU BLVD"
    },
    "authority": {
      "type": "object",
      "required": [
        "user_requirements",
        "designer_proposals",
        "precedence",
        "document_instructions_policy"
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "navigation": {
      "type": "object",
      "required": [
        "links"
      ]
    },
    "footer": {
      "type": "object"
    },
    "integration": {
      "type": "object"
    },
    "concept": {
      "type": "string"
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_sections_count": {
      "const": 16
    },
    "sections": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "kind",
          "heading",
          "heading_status",
          "lead",
          "copy_status",
          "content",
          "sources",
          "asset_ids",
          "desktop",
          "mobile",
          "cta",
          "states",
          "motion",
          "transition",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "kind": {
            "type": "string"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "heading_status": {
            "enum": [
              "existing_source_copy",
              "designer_copy"
            ]
          },
          "lead": {
            "type": "string"
          },
          "copy_status": {
            "enum": [
              "designer_copy",
              "designer_copy_based_on_source"
            ]
          },
          "content": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "desktop": {
            "type": "object"
          },
          "mobile": {
            "type": "object",
            "required": [
              "order"
            ],
            "properties": {
              "order": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          },
          "cta": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "action"
              ]
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "motion": {
            "type": "string"
          },
          "transition": {
            "type": "string"
          },
          "rationale": {
            "type": "object",
            "required": [
              "task",
              "solution",
              "basis",
              "expected_effect",
              "tradeoff",
              "verification"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
